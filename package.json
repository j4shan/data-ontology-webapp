{
  "name": "data-ontology-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build && node --watch --import tsx server/main.ts",
    "start": "node --import tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build web --outDir ../dist --emptyOutDir",
    "test": "node --import tsx --test tests/*.test.ts",
    "cli": "node --import tsx cli/main.ts"
  },
  "exports": {
    "./sdk": "./sdk/index.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "@playwright/test": "^1.56.0"
  }
}
